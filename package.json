{
  "name": "canvasnote",
  "version": "0.1.0",
  "description": "A local-first visual notebook for notes, media, and timestamped video research.",
  "private": true,
  "main": "out/main/index.js",
  "author": "Richy",
  "license": "MIT",
  "scripts": {
    "setup": "node scripts/setupDependencies.mjs",
    "predev": "npm run setup",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "prepreview": "npm run setup",
    "preview": "electron-vite preview",
    "package": "npm run setup && npm run build && electron-builder",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretest:e2e": "npm run setup",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "13.0.1",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tldraw": "5.2.5",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@swc/core": "1.15.46",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "electron-store": "11.0.2",
    "electron-vite": "5.0.0",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vitest": "4.1.10"
  },
  "build": {
    "appId": "com.canvasnote.app",
    "productName": "CanvasNote",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
